<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="Reorder.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:Reorder.Models"
    PreviewKeyDown="Page_PreviewKeyDown"
    mc:Ignorable="d">

    <Page.Resources>
        <Style x:Key="RoundIconButtonStyle" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
            <Setter Property="Width" Value="44" />
            <Setter Property="Height" Value="44" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="CornerRadius" Value="22" />
        </Style>

        <Style x:Key="StretchGridViewItemStyle" TargetType="GridViewItem" BasedOn="{StaticResource DefaultGridViewItemStyle}">
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Stretch" />
        </Style>

        <MenuFlyout x:Key="ItemMenu" Opening="ItemMenu_Opening">
            <MenuFlyoutItem x:Uid="MenuPreview" Click="MenuPreview_Click">
                <MenuFlyoutItem.Icon>
                    <FontIcon Glyph="&#xE8A1;" />
                </MenuFlyoutItem.Icon>
            </MenuFlyoutItem>
            <MenuFlyoutSeparator />
            <MenuFlyoutItem x:Uid="MenuMoveToStart" Click="MoveToStart_Click">
                <MenuFlyoutItem.Icon>
                    <FontIcon Glyph="&#xE74A;" />
                </MenuFlyoutItem.Icon>
            </MenuFlyoutItem>
            <MenuFlyoutItem x:Uid="MenuMoveToEnd" Click="MoveToEnd_Click">
                <MenuFlyoutItem.Icon>
                    <FontIcon Glyph="&#xE74B;" />
                </MenuFlyoutItem.Icon>
            </MenuFlyoutItem>
            <MenuFlyoutSubItem x:Uid="MenuMoveToStaging" Tag="StagingMenu">
                <MenuFlyoutSubItem.Icon>
                    <FontIcon Glyph="&#xE7B8;" />
                </MenuFlyoutSubItem.Icon>
            </MenuFlyoutSubItem>
            <MenuFlyoutSeparator />
            <MenuFlyoutItem
                Click="MenuToggleDelete_Click"
                KeyboardAcceleratorTextOverride="Delete"
                Tag="DeleteItem"
                x:Uid="MenuDelete">
                <MenuFlyoutItem.Icon>
                    <FontIcon Glyph="&#xE74D;" />
                </MenuFlyoutItem.Icon>
            </MenuFlyoutItem>
            <MenuFlyoutItem x:Uid="MenuStripExif" Click="MenuStripExif_Click">
                <MenuFlyoutItem.Icon>
                    <FontIcon Glyph="&#xE8EC;" />
                </MenuFlyoutItem.Icon>
            </MenuFlyoutItem>
        </MenuFlyout>
    </Page.Resources>

    <Grid x:Name="RootGrid" AllowDrop="True">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!--  Header  -->
        <Grid Padding="20,0,12,8" ColumnSpacing="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel VerticalAlignment="Center" Spacing="2">
                <TextBlock
                    x:Name="FolderNameText"
                    Style="{StaticResource SubtitleTextBlockStyle}"
                    x:Uid="FolderNameText"
                    TextTrimming="CharacterEllipsis" />
                <TextBlock
                    x:Name="SummaryText"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Style="{StaticResource CaptionTextBlockStyle}"
                    TextTrimming="CharacterEllipsis"
                    TextWrapping="NoWrap" />
            </StackPanel>

            <StackPanel
                Grid.Column="1"
                VerticalAlignment="Center"
                Orientation="Horizontal"
                Spacing="8">
                <StackPanel
                    VerticalAlignment="Center"
                    Orientation="Horizontal"
                    Spacing="6"
                    x:Uid="ZoomPanel">
                    <FontIcon
                        FontSize="14"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Glyph="&#xE71F;" />
                    <Slider
                        x:Name="ZoomSlider"
                        Width="120"
                        VerticalAlignment="Center"
                        IsThumbToolTipEnabled="False"
                        Maximum="360"
                        Minimum="80"
                        StepFrequency="4"
                        Value="148" />
                    <FontIcon
                        FontSize="14"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Glyph="&#xE8A3;" />
                </StackPanel>
                <CommandBar
                    x:Name="Toolbar"
                    Background="Transparent"
                    DefaultLabelPosition="Right"
                    OverflowButtonVisibility="Collapsed">
                    <AppBarButton
                        x:Name="OpenButton"
                        Click="OpenFolder_Click"
                        x:Uid="OpenButton">
                        <AppBarButton.Icon>
                            <FontIcon Glyph="&#xE838;" />
                        </AppBarButton.Icon>
                        <AppBarButton.KeyboardAccelerators>
                            <KeyboardAccelerator Key="O" Modifiers="Control" />
                        </AppBarButton.KeyboardAccelerators>
                    </AppBarButton>
                    <AppBarSeparator />
                    <AppBarButton
                        x:Name="UndoButton"
                        Click="Undo_Click"
                        x:Uid="UndoButton"
                        LabelPosition="Collapsed">
                        <AppBarButton.Icon>
                            <FontIcon Glyph="&#xE7A7;" />
                        </AppBarButton.Icon>
                        <AppBarButton.KeyboardAccelerators>
                            <KeyboardAccelerator Key="Z" Modifiers="Control" />
                        </AppBarButton.KeyboardAccelerators>
                    </AppBarButton>
                    <AppBarButton
                        x:Name="RedoButton"
                        Click="Redo_Click"
                        x:Uid="RedoButton"
                        LabelPosition="Collapsed">
                        <AppBarButton.Icon>
                            <FontIcon Glyph="&#xE7A6;" />
                        </AppBarButton.Icon>
                        <AppBarButton.KeyboardAccelerators>
                            <KeyboardAccelerator Key="Y" Modifiers="Control" />
                            <KeyboardAccelerator Key="Z" Modifiers="Control,Shift" />
                        </AppBarButton.KeyboardAccelerators>
                    </AppBarButton>
                    <AppBarSeparator />
                    <AppBarButton
                        x:Name="SortButton"
                        Click="SortByName_Click"
                        x:Uid="SortButton">
                        <AppBarButton.Icon>
                            <FontIcon Glyph="&#xE8CB;" />
                        </AppBarButton.Icon>
                    </AppBarButton>
                    <AppBarButton
                        x:Name="PreviewButton"
                        Click="PreviewButton_Click"
                        x:Uid="PreviewButton"
                        LabelPosition="Collapsed">
                        <AppBarButton.Icon>
                            <FontIcon Glyph="&#xE8A1;" />
                        </AppBarButton.Icon>
                    </AppBarButton>
                    <AppBarButton
                        x:Name="DeleteButton"
                        Click="ToggleDelete_Click"
                        x:Uid="DeleteButton"
                        LabelPosition="Collapsed">
                        <AppBarButton.Icon>
                            <FontIcon Glyph="&#xE74D;" />
                        </AppBarButton.Icon>
                    </AppBarButton>
                    <AppBarButton
                        x:Name="StripButton"
                        Click="StripExif_Click"
                        x:Uid="StripButton"
                        LabelPosition="Collapsed">
                        <AppBarButton.Icon>
                            <FontIcon Glyph="&#xE8EC;" />
                        </AppBarButton.Icon>
                    </AppBarButton>
                    <AppBarToggleButton
                        x:Name="StagingToggle"
                        Click="StagingToggle_Click"
                        IsChecked="True"
                        x:Uid="StagingToggle">
                        <AppBarToggleButton.Icon>
                            <FontIcon Glyph="&#xE7B8;" />
                        </AppBarToggleButton.Icon>
                    </AppBarToggleButton>
                </CommandBar>
                <Button
                    x:Name="SaveButton"
                    Click="Save_Click"
                    Style="{StaticResource AccentButtonStyle}"
                    x:Uid="SaveButton">
                    <Button.KeyboardAccelerators>
                        <KeyboardAccelerator Key="S" Modifiers="Control" />
                    </Button.KeyboardAccelerators>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon FontSize="14" Glyph="&#xE74E;" />
                        <TextBlock x:Uid="SaveButtonText" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <!--  Content  -->
        <Grid
            Grid.Row="1"
            Margin="12,0,12,12"
            ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!--  Main list  -->
            <Grid
                Background="{ThemeResource LayerFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8">
                <GridView
                    x:Name="ImageGrid"
                    Padding="12,12,4,12"
                    AllowDrop="True"
                    CanDragItems="True"
                    CanReorderItems="True"
                    DoubleTapped="AnyGrid_DoubleTapped"
                    DragItemsCompleted="AnyGrid_DragItemsCompleted"
                    DragItemsStarting="AnyGrid_DragItemsStarting"
                    ItemContainerStyle="{StaticResource StretchGridViewItemStyle}"
                    ItemsSource="{x:Bind Items}"
                    KeyDown="AnyGrid_KeyDown"
                    Loaded="ImageGrid_Loaded"
                    SelectionChanged="ImageGrid_SelectionChanged"
                    SelectionMode="Extended">
                    <GridView.ItemsPanel>
                        <ItemsPanelTemplate>
                            <ItemsWrapGrid Background="Transparent" Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </GridView.ItemsPanel>
                    <GridView.ItemTemplate>
                        <DataTemplate x:DataType="models:ImageItem">
                            <Grid
                                Padding="6"
                                Background="Transparent"
                                ContextFlyout="{StaticResource ItemMenu}"
                                RowSpacing="6"
                                ToolTipService.ToolTip="{x:Bind FileName, Mode=OneWay}">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Border
                                    Background="{ThemeResource ControlFillColorSecondaryBrush}"
                                    CornerRadius="4"
                                    Opacity="{x:Bind ContentOpacity, Mode=OneWay}">
                                    <Image Source="{x:Bind Thumbnail, Mode=OneWay}" Stretch="Uniform" />
                                </Border>
                                <Border
                                    MinWidth="24"
                                    Margin="6"
                                    Padding="6,1"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Top"
                                    Background="{ThemeResource AcrylicInAppFillColorDefaultBrush}"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                    BorderThickness="1"
                                    CornerRadius="4"
                                    Visibility="{x:Bind PositionVisibility, Mode=OneWay}">
                                    <TextBlock
                                        HorizontalAlignment="Center"
                                        Style="{StaticResource CaptionTextBlockStyle}"
                                        Text="{x:Bind PositionText, Mode=OneWay}" />
                                </Border>
                                <Border
                                    Width="36"
                                    Height="36"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Background="{ThemeResource SystemFillColorCriticalBrush}"
                                    CornerRadius="18"
                                    Visibility="{x:Bind DeleteMarkVisibility, Mode=OneWay}">
                                    <FontIcon
                                        FontSize="16"
                                        Foreground="White"
                                        Glyph="&#xE74D;" />
                                </Border>
                                <TextBlock
                                    Grid.Row="1"
                                    HorizontalAlignment="Center"
                                    Opacity="{x:Bind ContentOpacity, Mode=OneWay}"
                                    Style="{StaticResource CaptionTextBlockStyle}"
                                    Text="{x:Bind FileName, Mode=OneWay}"
                                    TextTrimming="CharacterEllipsis"
                                    TextWrapping="NoWrap" />
                            </Grid>
                        </DataTemplate>
                    </GridView.ItemTemplate>
                </GridView>

                <StackPanel
                    x:Name="EmptyState"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Spacing="12">
                    <FontIcon
                        FontSize="48"
                        Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                        Glyph="&#xE91B;" />
                    <TextBlock
                        HorizontalAlignment="Center"
                        Style="{StaticResource BodyStrongTextBlockStyle}"
                        x:Uid="EmptyTitle" />
                    <TextBlock
                        HorizontalAlignment="Center"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        x:Uid="EmptyHint" />
                    <Button
                        Margin="0,8,0,0"
                        HorizontalAlignment="Center"
                        Click="OpenFolder_Click"
                        x:Uid="EmptyOpenButton"
                        Style="{StaticResource AccentButtonStyle}" />
                </StackPanel>

                <ProgressBar
                    x:Name="BusyBar"
                    VerticalAlignment="Top"
                    IsIndeterminate="True"
                    Visibility="Collapsed" />
            </Grid>

            <!--  Staging areas  -->
            <Grid
                x:Name="StagingPanel"
                Grid.Column="1"
                Width="280"
                Background="{ThemeResource LayerFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8"
                RowSpacing="4">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Grid Padding="14,8,6,0">
                    <TextBlock
                        VerticalAlignment="Center"
                        Style="{StaticResource BodyStrongTextBlockStyle}"
                        x:Uid="StagingTitle" />
                    <Button
                        x:Name="AddStagingButton"
                        HorizontalAlignment="Right"
                        Click="AddStaging_Click"
                        Style="{StaticResource SubtleButtonStyle}"
                        x:Uid="AddStagingButton">
                        <FontIcon FontSize="14" Glyph="&#xE710;" />
                    </Button>
                </Grid>
                <ScrollViewer Grid.Row="1" Padding="8,0,8,8">
                    <StackPanel Spacing="8">
                        <ItemsControl ItemsSource="{x:Bind StagingAreas}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Spacing="8" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="models:StagingArea">
                                    <Grid
                                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                        BorderThickness="1"
                                        CornerRadius="6">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <Grid Padding="4,4,2,0" ColumnSpacing="4">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBox
                                                MinHeight="0"
                                                Padding="6,4"
                                                Background="Transparent"
                                                BorderThickness="0"
                                                Text="{x:Bind Name, Mode=TwoWay}"
                                                x:Uid="StagingNameBox" />
                                            <TextBlock
                                                Grid.Column="1"
                                                VerticalAlignment="Center"
                                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                Style="{StaticResource CaptionTextBlockStyle}"
                                                Text="{x:Bind CountText, Mode=OneWay}" />
                                            <Button
                                                Grid.Column="2"
                                                Padding="6"
                                                Style="{StaticResource SubtleButtonStyle}">
                                                <FontIcon FontSize="12" Glyph="&#xE712;" />
                                                <Button.Flyout>
                                                    <MenuFlyout>
                                                        <MenuFlyoutItem Click="StagingRestoreAll_Click" Tag="{x:Bind}" x:Uid="StagingRestoreAll">
                                                            <MenuFlyoutItem.Icon>
                                                                <FontIcon Glyph="&#xE74B;" />
                                                            </MenuFlyoutItem.Icon>
                                                        </MenuFlyoutItem>
                                                        <MenuFlyoutItem Click="StagingRemove_Click" Tag="{x:Bind}" x:Uid="StagingRemove">
                                                            <MenuFlyoutItem.Icon>
                                                                <FontIcon Glyph="&#xE711;" />
                                                            </MenuFlyoutItem.Icon>
                                                        </MenuFlyoutItem>
                                                    </MenuFlyout>
                                                </Button.Flyout>
                                            </Button>
                                        </Grid>
                                        <GridView
                                            Grid.Row="1"
                                            MinHeight="84"
                                            Padding="6,4,0,6"
                                            AllowDrop="True"
                                            Background="Transparent"
                                            CanDragItems="True"
                                            CanReorderItems="True"
                                            DoubleTapped="AnyGrid_DoubleTapped"
                                            DragItemsCompleted="AnyGrid_DragItemsCompleted"
                                            DragItemsStarting="AnyGrid_DragItemsStarting"
                                            ItemsSource="{x:Bind Items}"
                                            KeyDown="AnyGrid_KeyDown"
                                            Loaded="StagingGrid_Loaded"
                                            Unloaded="StagingGrid_Unloaded"
                                            ScrollViewer.VerticalScrollBarVisibility="Disabled"
                                            ScrollViewer.VerticalScrollMode="Disabled"
                                            SelectionMode="Extended">
                                            <GridView.ItemTemplate>
                                                <DataTemplate x:DataType="models:ImageItem">
                                                    <Grid
                                                        Width="76"
                                                        Height="76"
                                                        Padding="2"
                                                        Background="Transparent"
                                                        ContextFlyout="{StaticResource ItemMenu}"
                                                        ToolTipService.ToolTip="{x:Bind FileName, Mode=OneWay}">
                                                        <Border
                                                            Background="{ThemeResource ControlFillColorSecondaryBrush}"
                                                            CornerRadius="4"
                                                            Opacity="{x:Bind ContentOpacity, Mode=OneWay}">
                                                            <Image Source="{x:Bind Thumbnail, Mode=OneWay}" Stretch="Uniform" />
                                                        </Border>
                                                        <Border
                                                            Width="24"
                                                            Height="24"
                                                            HorizontalAlignment="Center"
                                                            VerticalAlignment="Center"
                                                            Background="{ThemeResource SystemFillColorCriticalBrush}"
                                                            CornerRadius="12"
                                                            Visibility="{x:Bind DeleteMarkVisibility, Mode=OneWay}">
                                                            <FontIcon
                                                                FontSize="12"
                                                                Foreground="White"
                                                                Glyph="&#xE74D;" />
                                                        </Border>
                                                    </Grid>
                                                </DataTemplate>
                                            </GridView.ItemTemplate>
                                        </GridView>
                                        <TextBlock
                                            Grid.Row="1"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                            IsHitTestVisible="False"
                                            Style="{StaticResource CaptionTextBlockStyle}"
                                            x:Uid="StagingEmptyText"
                                            Visibility="{x:Bind EmptyVisibility, Mode=OneWay}" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!--  Drop here to create a new area  -->
                        <Border
                            x:Name="NewStagingDropZone"
                            MinHeight="64"
                            Padding="12"
                            AllowDrop="True"
                            Background="Transparent"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="6"
                            DragOver="NewStagingDropZone_DragOver"
                            Drop="NewStagingDropZone_Drop">
                            <TextBlock
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                Style="{StaticResource CaptionTextBlockStyle}"
                                x:Uid="NewStagingDropText"
                                TextAlignment="Center"
                                TextWrapping="Wrap" />
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Grid>

        <InfoBar
            x:Name="StatusBar"
            Grid.Row="2"
            Margin="12,0,12,12"
            IsOpen="False" />

        <!--  Single image preview  -->
        <Grid
            x:Name="PreviewOverlay"
            Grid.RowSpan="3"
            Background="{ThemeResource AcrylicInAppFillColorDefaultBrush}"
            PointerWheelChanged="PreviewOverlay_PointerWheelChanged"
            Tapped="PreviewOverlay_Tapped"
            Visibility="Collapsed">
            <Image
                x:Name="PreviewImage"
                Margin="80,16,80,72"
                Stretch="Uniform" />
            <Button
                x:Name="PrevButton"
                Margin="16,0"
                HorizontalAlignment="Left"
                Click="PrevButton_Click"
                Style="{StaticResource RoundIconButtonStyle}"
                x:Uid="PrevButton">
                <FontIcon FontSize="16" Glyph="&#xE76B;" />
            </Button>
            <Button
                x:Name="NextButton"
                Margin="16,0"
                HorizontalAlignment="Right"
                Click="NextButton_Click"
                Style="{StaticResource RoundIconButtonStyle}"
                x:Uid="NextButton">
                <FontIcon FontSize="16" Glyph="&#xE76C;" />
            </Button>
            <Button
                x:Name="ClosePreviewButton"
                Margin="16"
                HorizontalAlignment="Right"
                VerticalAlignment="Top"
                Click="ClosePreview_Click"
                Style="{StaticResource RoundIconButtonStyle}"
                x:Uid="ClosePreviewButton">
                <FontIcon FontSize="14" Glyph="&#xE711;" />
            </Button>
            <Border
                Margin="0,0,0,20"
                Padding="14,6"
                HorizontalAlignment="Center"
                VerticalAlignment="Bottom"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8">
                <StackPanel Orientation="Horizontal" Spacing="12">
                    <TextBlock
                        x:Name="PreviewNameText"
                        MaxWidth="480"
                        TextTrimming="CharacterEllipsis" />
                    <TextBlock x:Name="PreviewCounterText" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </StackPanel>
            </Border>
        </Grid>

        <!--  Save dialog  -->
        <ContentDialog
            x:Name="SaveDialog"
            x:Uid="SaveDialog"
            DefaultButton="Primary">
            <StackPanel Width="400" Spacing="12">
                <CheckBox x:Name="RenameOnSaveBox" x:Uid="RenameOnSaveBox" IsChecked="True" />
                <StackPanel x:Name="RenameOptionsPanel" Spacing="12">
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBox
                            x:Name="PrefixBox"
                            x:Uid="PrefixBox" />
                        <TextBox
                            x:Name="SuffixBox"
                            Grid.Column="1"
                            x:Uid="SuffixBox" />
                    </Grid>
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <NumberBox
                            x:Name="StartBox"
                            x:Uid="StartBox"
                            Minimum="0"
                            SpinButtonPlacementMode="Compact"
                            Value="1" />
                        <NumberBox
                            x:Name="DigitsBox"
                            Grid.Column="1"
                            x:Uid="DigitsBox"
                            Maximum="10"
                            Minimum="1"
                            SpinButtonPlacementMode="Compact"
                            Value="3" />
                    </Grid>
                    <ComboBox
                        x:Name="StagingModeBox"
                        HorizontalAlignment="Stretch"
                        x:Uid="StagingModeBox"
                        SelectedIndex="0">
                        <ComboBoxItem x:Uid="StagingModeAppend" />
                        <ComboBoxItem x:Uid="StagingModeKeep" />
                    </ComboBox>
                    <CheckBox x:Name="StripOnRenameBox" x:Uid="StripOnRenameBox" />
                    <StackPanel Spacing="4">
                        <TextBlock
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            x:Uid="RenamePreviewLabel" />
                        <Border
                            Padding="10,8"
                            Background="{ThemeResource ControlFillColorSecondaryBrush}"
                            CornerRadius="4">
                            <TextBlock
                                x:Name="RenamePreviewText"
                                FontFamily="Consolas"
                                FontSize="12"
                                TextWrapping="Wrap" />
                        </Border>
                    </StackPanel>
                </StackPanel>
                <TextBlock x:Name="SaveSummaryText" TextWrapping="Wrap" />
                <TextBlock
                    x:Name="RenameErrorText"
                    Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                    Style="{StaticResource CaptionTextBlockStyle}"
                    TextWrapping="Wrap"
                    Visibility="Collapsed" />
            </StackPanel>
        </ContentDialog>
    </Grid>
</Page>
